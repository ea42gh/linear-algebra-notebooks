ARG BASE_IMAGE=julia-python:0.1
FROM ${BASE_IMAGE}

ENV JULIA_CONDAPKG_BACKEND=Null
ENV CONDAPKG_BACKEND=Null
ENV JULIA_PYTHONCALL_EXE=/usr/local/bin/python3
ENV JULIA_PROJECT=/home/jovyan/.julia_env
ENV JULIACALL_PROJECT=/home/jovyan/.julia_env
ENV PYJULIAPKG_PROJECT=/home/jovyan/.julia_env
ENV JULIAPKG_PROJECT=/home/jovyan/.julia_env
ENV TERM=xterm-256color
ENV INPUTRC=/home/jovyan/.inputrc
ENV XDG_DATA_HOME=/home/jovyan/.local/share
ENV JUPYTER_DATA_DIR=/home/jovyan/.local/share/jupyter

USER root
WORKDIR /tmp

RUN mkdir -p /opt/ea42gh \
 && chown jovyan:jovyan /opt/ea42gh

RUN /usr/local/bin/python3 -m pip install --no-cache-dir --upgrade \
    pip setuptools wheel
RUN /usr/local/bin/python3 -m pip install --no-cache-dir \
    jupyter jupyterlab "notebook<7" nbclassic mkdocs "mkdocs-material[imaging]" pymdown-extensions sympy
RUN /usr/local/bin/python3 -m pip install --no-cache-dir \
    mkdocs-macros-plugin "mkdocstrings[python]" juliacall webio_jupyter_extension

USER jovyan
WORKDIR /opt/ea42gh

ARG JUPYTER_TIKZ_REF=itikz_port
RUN git clone --branch ${JUPYTER_TIKZ_REF} --single-branch https://github.com/ea42gh/jupyter-tikz.git

USER root
RUN /usr/local/bin/python3 -m pip install --no-cache-dir -e /opt/ea42gh/jupyter-tikz

USER jovyan
RUN mkdir -p /opt/ea42gh/docs

USER root
RUN mkdir -p /home/jovyan/.local/bin \
 && ln -s /usr/local/julia/bin/julia /home/jovyan/.local/bin/julia \
 && chown -R jovyan:jovyan /home/jovyan/.local/bin

USER jovyan
RUN /usr/local/bin/python3 -c "from pathlib import Path; path = Path('/opt/ea42gh/jupyter-tikz/mkdocs.yml'); text = path.read_text(); text = text.replace('\\n  - social\\n', '\\n'); path.write_text(text)"
RUN /usr/local/bin/python3 -m mkdocs build \
    -f /opt/ea42gh/jupyter-tikz/mkdocs.yml \
    -d /opt/ea42gh/docs/jupyter-tikz
RUN mkdir -p /opt/ea42gh/docs/jupyter-tikz/notebooks \
 && cp -r /opt/ea42gh/jupyter-tikz/notebooks/. /opt/ea42gh/docs/jupyter-tikz/notebooks/

RUN git clone https://github.com/ea42gh/LAlatex.git
RUN julia -e 'using Pkg; Pkg.activate(ENV["JULIA_PROJECT"]); Pkg.add(["LaTeXStrings", "Latexify", "Documenter", "PythonCall", "Symbolics", "BlockArrays"]); Pkg.develop(path="/opt/ea42gh/LAlatex")'
RUN rm -f /home/jovyan/.julia/prefs/PythonCall.toml /home/jovyan/.julia/prefs/CondaPkg.toml \
 && rm -rf /home/jovyan/.julia/conda* /home/jovyan/.julia/.CondaPkg \
 && mkdir -p /home/jovyan/.julia/prefs \
 && printf '%s\n' \
    'python_executable = "/usr/local/bin/python3"' \
    'conda_backend = "Null"' \
    > /home/jovyan/.julia/prefs/PythonCall.toml
RUN julia -e 'using Pkg; Pkg.activate(ENV["JULIA_PROJECT"]); using LAlatex, PythonCall; LAlatex.import_sympy()'
RUN julia -e 'using PythonCall; println(pyimport("sys").executable); pyimport("sympy"); println("PythonCall OK")'

USER jovyan
WORKDIR /home/jovyan

ENV HOME=/home/jovyan
USER root
RUN mkdir -p /home/jovyan/.local/share/jupyter \
 && chown -R jovyan:jovyan /home/jovyan/.local
USER jovyan
RUN julia -e 'using Pkg; Pkg.activate(ENV["JULIA_PROJECT"]); Pkg.add("IJulia"); using IJulia; IJulia.installkernel("Julia", env=Dict("JULIA_PROJECT"=>ENV["JULIA_PROJECT"], "JULIA_PYTHONCALL_EXE"=>ENV["JULIA_PYTHONCALL_EXE"], "JULIA_CONDAPKG_BACKEND"=>ENV["JULIA_CONDAPKG_BACKEND"], "CONDAPKG_BACKEND"=>ENV["CONDAPKG_BACKEND"], "PYTHONNOUSERSITE"=>"1", "PYTHONDONTWRITEBYTECODE"=>"1", "ENABLE_JULIACALL_AUTACTIVATE"=>"0"))'
RUN julia -e 'using Pkg; Pkg.activate(ENV["JULIA_PROJECT"]); Pkg.add("WebIO")'
RUN julia -e 'using Pkg; Pkg.activate(ENV["JULIA_PROJECT"]); include("/opt/ea42gh/LAlatex/docs/make.jl")'
RUN cp -r /opt/ea42gh/LAlatex/docs/build /opt/ea42gh/docs/LAlatex
RUN ln -s /opt/ea42gh/docs /home/jovyan/docs
RUN echo "stty erase ^?" >> /home/jovyan/.bashrc

RUN mkdir -p /home/jovyan/.ipython/profile_default/startup
COPY binder/10-julia-magic.py \
    /home/jovyan/.ipython/profile_default/startup/10-julia-magic.py
COPY binder/inputrc /home/jovyan/.inputrc
COPY binder/sitecustomize.py /usr/local/lib/python3.11/site-packages/sitecustomize.py
COPY binder/jupyter_server_config.py /etc/jupyter/jupyter_server_config.py

# JupyterLab user settings (match reference settings)
RUN mkdir -p /home/jovyan/.jupyter/lab/user-settings/@jupyterlab/apputils-extension \
 && printf '{\n  "enabled": false\n}\n' \
 > /home/jovyan/.jupyter/lab/user-settings/@jupyterlab/apputils-extension/announcements.jupyterlab-settings \
 && printf '{\n    "fetchNews": "false"\n}\n' \
 > /home/jovyan/.jupyter/lab/user-settings/@jupyterlab/apputils-extension/notification.jupyterlab-settings \
 && mkdir -p /home/jovyan/.jupyter/lab/user-settings/@jupyterlab/codemirror-extension \
 && printf '{\n  "lineNumbers": true,\n  "codeFolding": true,\n  "showTrailingWhitespace": true\n}\n' \
 > /home/jovyan/.jupyter/lab/user-settings/@jupyterlab/codemirror-extension/preferences.jupyterlab-settings \
 && mkdir -p /home/jovyan/.jupyter/lab/user-settings/@jupyterlab/fileeditor-extension \
 && printf '{\n  "codeFolding": true,\n  "lineNumbers": true,\n  "showTrailingWhitespace": true\n}\n' \
 > /home/jovyan/.jupyter/lab/user-settings/@jupyterlab/fileeditor-extension/plugin.jupyterlab-settings \
 && mkdir -p /home/jovyan/.jupyter/lab/user-settings/@jupyterlab/notebook-extension \
 && printf '{\n    "enableKernelInitNotification": false,\n    "codeCellConfig": {\n        "codeFolding": true,\n        "highlightTrailingWhitespace": true,\n        "lineNumbers": true\n    },\n    "defaultCell": "code",\n    "autoStartDefaultKernel": false,\n    "showInputPlaceholder": true,\n    "inputHistoryScope": "global",\n    "kernelShutdown": false,\n    "markdownCellConfig": {\n        "lineNumbers": false,\n        "matchBrackets": false\n    },\n    "autoRenderMarkdownCells": false,\n    "rawCellConfig": {\n        "lineNumbers": false,\n        "matchBrackets": false\n    },\n    "scrollPastEnd": true,\n    "recordTiming": false,\n    "overscanCount": 1,\n    "maxNumberOutputs": 50,\n    "scrollHeadingToTop": true,\n    "showEditorForReadOnlyMarkdown": true,\n    "kernelStatus": {\n        "showOnStatusBar": false,\n        "showProgress": true,\n        "showJumpToRecentExecutionButton": false\n    },\n    "documentWideUndoRedo": false,\n    "showHiddenCellsButton": true,\n    "renderingLayout": "default",\n    "sideBySideLeftMarginOverride": "10px",\n    "sideBySideRightMarginOverride": "10px",\n    "sideBySideOutputRatio": 1,\n    "windowingMode": "contentVisibility",\n    "accessKernelHistory": false,\n    "addExtraLineOnCellMerge": true,\n    "showMinimap": false,\n    "useSystemClipboardForCells": false\n}\n' \
 > /home/jovyan/.jupyter/lab/user-settings/@jupyterlab/notebook-extension/tracker.jupyterlab-settings \
 && chown -R jovyan:jovyan /home/jovyan/.jupyter

# JupyterLab system overrides (belt-and-suspenders)
USER root
RUN mkdir -p /usr/local/share/jupyter/lab/settings \
 && cat <<'EOF' > /usr/local/share/jupyter/lab/settings/overrides.json
{
  "@jupyterlab/apputils-extension:announcements": {"enabled": false},
  "@jupyterlab/apputils-extension:notification": {"fetchNews": "false"},
  "@jupyterlab/codemirror-extension:preferences": {"codeFolding": true, "lineNumbers": true, "showTrailingWhitespace": true},
  "@jupyterlab/fileeditor-extension:plugin": {"codeFolding": true, "lineNumbers": true, "showTrailingWhitespace": true},
  "@jupyterlab/notebook-extension:tracker": {"enableKernelInitNotification": false, "codeCellConfig": {"codeFolding": true, "highlightTrailingWhitespace": true, "lineNumbers": true}}
}
EOF
USER jovyan

WORKDIR /home/jovyan

EXPOSE 8888
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--no-browser", "--ServerApp.token=", "--ServerApp.password=", "--notebook-dir=/home/jovyan"]
