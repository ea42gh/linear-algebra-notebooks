ARG BASE_IMAGE=julia-python-jupyter:1.0
FROM ${BASE_IMAGE}

ENV JULIA_CONDAPKG_BACKEND=Null
ENV JULIA_PYTHONCALL_EXE=/usr/local/bin/python3
ENV JULIA_PROJECT=/home/jovyan/.julia_env
ENV JULIACALL_PROJECT=/home/jovyan/.julia_env
ENV PYTHON_JULIACALL_EXE=/usr/local/julia/bin/julia
ENV PYTHON_JULIACALL_PROJECT=/home/jovyan/.julia_env
ENV PYJULIAPKG_PROJECT=/home/jovyan/.julia_env
ENV JULIAPKG_PROJECT=/home/jovyan/.julia_env
ENV JULIA_PKG_PRECOMPILE_AUTO=0

USER root
WORKDIR /tmp

RUN mkdir -p /opt/ea42gh \
 && chown jovyan:jovyan /opt/ea42gh
COPY binder/docs/README.md /opt/ea42gh/docs/README.md

RUN apt-get update && apt-get install -y --no-install-recommends --fix-missing \
    graphviz-dev \
    ffmpeg \
    libcairo2-dev \
    libpango1.0-dev \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libdrm2 \
    libegl1 \
    libgbm1 \
    libgl1-mesa-dri \
    libgles2 \
    libgtk-3-0 \
    libnss3 \
    libosmesa6 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxi6 \
    libxkbcommon0 \
    libxrandr2 \
    libxshmfence1 \
    pkg-config \
 && rm -rf /var/lib/apt/lists/*

# Install Julia packages early for better layer caching.
RUN /usr/local/bin/python3 -c 'import json, importlib.util, pathlib; p = pathlib.Path(importlib.util.find_spec("juliacall").origin).parent / "juliapkg.json"; v = json.loads(p.read_text())["packages"]["PythonCall"]["version"].lstrip("="); print(v)' > /tmp/pythoncall_jl_version
COPY binder/install_julia_packages.jl /tmp/install_julia_packages.jl
RUN mkdir -p /home/jovyan/.julia /home/jovyan/.julia_env \
 && chown -R jovyan:jovyan /home/jovyan/.julia /home/jovyan/.julia_env

USER jovyan

# Run package install with network registry (override offline settings for this step).
RUN JULIA_PKG_OFFLINE=false JULIA_PKG_SERVER=https://pkg.julialang.org \
    julia --startup-file=no /tmp/install_julia_packages.jl
RUN julia -e 'using Pkg; Pkg.Registry.add("General")'

USER root
RUN /usr/local/bin/python3 -m pip install --no-cache-dir jupyter-server-proxy
RUN /usr/local/bin/python3 -m pip install --no-cache-dir vsapy

COPY binder/start-pluto /usr/local/bin/start-pluto
RUN chmod 0755 /usr/local/bin/start-pluto

COPY binder/jupyter_server_config.py /etc/jupyter/jupyter_server_config.py
RUN mkdir -p /home/jovyan/.ipython/profile_default/startup
COPY binder/10-julia-magic.py \
    /home/jovyan/.ipython/profile_default/startup/10-julia-magic.py
RUN chown -R jovyan:jovyan /home/jovyan/.ipython

COPY binder/requirements.txt /tmp/requirements.txt
COPY binder/install_python_libraries.py /tmp/install_python_libraries.py
RUN /usr/local/bin/python3 /tmp/install_python_libraries.py
WORKDIR /opt/ea42gh

ARG MATRIXLAYOUT_COMMIT=ade1ef65e48233124cac6cdd1a09f29045f5bee9
ARG LAFIGURESPECS_COMMIT=2634f03636fdb464a3b850be0891716076d8f8db
ARG GENLAPROBLEMS_COMMIT=6db4b8c31e5d8b440faa63d42593e59994cc94a1
RUN git clone https://github.com/ea42gh/matrixlayout.git \
 && cd matrixlayout \
 && git checkout ${MATRIXLAYOUT_COMMIT}
RUN git clone https://github.com/ea42gh/LAFigureSpecs.git \
 && cd LAFigureSpecs \
 && git checkout ${LAFIGURESPECS_COMMIT}
RUN git clone https://github.com/ea42gh/LATeachingSuite.jl.git
RUN git clone https://github.com/ea42gh/GenLAProblems.git \
 && cd GenLAProblems \
 && git checkout ${GENLAPROBLEMS_COMMIT}
RUN julia -e 'using Pkg; \
Pkg.activate("/opt/ea42gh/GenLAProblems"); \
Pkg.develop(path="/opt/ea42gh/LAlatex"); \
Pkg.add(Pkg.PackageSpec(name="AbstractAlgebra", version="0.48")); \
v = String(strip(read("/tmp/pythoncall_jl_version", String))); \
Pkg.add(Pkg.PackageSpec(name="PythonCall", version=v)); \
Pkg.resolve(); \
Pkg.instantiate()'

USER root
RUN /usr/local/bin/python3 -m pip install --no-cache-dir --no-build-isolation --no-deps -e /opt/ea42gh/LAlatex \
 && /usr/local/bin/python3 -c "import lalatex; print('lalatex Python bridge:', lalatex.__file__)"
RUN /usr/local/bin/python3 -m pip install --no-cache-dir -e /opt/ea42gh/matrixlayout
RUN /usr/local/bin/python3 -m pip install --no-cache-dir -e /opt/ea42gh/LAFigureSpecs
USER jovyan

RUN mkdir -p /home/jovyan/.julia/prefs \
 && printf '%s\n' \
    'python_executable = "/usr/local/bin/python3"' \
    'conda_backend = "Null"' \
    > /home/jovyan/.julia/prefs/PythonCall.toml

RUN julia -e 'using PythonCall; pyimport("LAFigureSpecs"); pyimport("matrixlayout"); println("PythonCall LAFigureSpecs/matrixlayout OK")'

RUN /usr/local/bin/python3 -m mkdocs build \
    -f /opt/ea42gh/matrixlayout/mkdocs.yml \
    -d /opt/ea42gh/docs/matrixlayout
RUN mkdir -p /opt/ea42gh/docs/matrixlayout/notebooks \
 && cp -r /opt/ea42gh/matrixlayout/docs/notebooks/. /opt/ea42gh/docs/matrixlayout/notebooks/
RUN /usr/local/bin/python3 -m mkdocs build \
    -f /opt/ea42gh/LAFigureSpecs/mkdocs.yml \
    -d /opt/ea42gh/docs/LAFigureSpecs
RUN mkdir -p /opt/ea42gh/docs/LAFigureSpecs/notebooks \
 && cp -r /opt/ea42gh/LAFigureSpecs/docs/notebooks/. /opt/ea42gh/docs/LAFigureSpecs/notebooks/

RUN PYTHONPYCACHEPREFIX=/tmp/pycache /usr/local/bin/python3 -m compileall -q \
    /opt/ea42gh/jupyter-tikz \
    /opt/ea42gh/LAFigureSpecs \
    /opt/ea42gh/matrixlayout

RUN julia -e 'using Pkg; \
Pkg.activate(ENV["JULIA_PROJECT"]); \
Pkg.develop(path="/opt/ea42gh/GenLAProblems"); \
Pkg.develop(path="/opt/ea42gh/LATeachingSuite.jl"); \
Pkg.resolve(); \
Pkg.instantiate(); \
println("Runtime env instantiated")'
RUN julia -e 'using Pkg; \
Pkg.activate(ENV["JULIA_PROJECT"]); \
v = String(strip(read("/tmp/pythoncall_jl_version", String))); \
Pkg.add(Pkg.PackageSpec(name="PythonCall", version=v)); \
Pkg.resolve(); \
Pkg.instantiate(); \
println("Pinned PythonCall.jl to JuliaCall requirement: " * v)'
RUN julia -e 'using Pkg; \
Pkg.activate(ENV["JULIA_PROJECT"]); \
names = ["GenLAProblems", "LAlatex"]; \
pkgs = [Pkg.PackageSpec(name=name) for name in names if haskey(Pkg.project().dependencies, name)]; \
Pkg.precompile(pkgs; strict=false)'
RUN julia -e 'using Pkg; \
Pkg.activate(ENV["JULIA_PROJECT"]); \
names = filter(!isempty, readlines("/home/jovyan/.julia_env_precompile_blocks/core.txt")); \
pkgs = [Pkg.PackageSpec(name=name) for name in names if haskey(Pkg.project().dependencies, name)]; \
Pkg.precompile(pkgs; strict=false)'
RUN julia -e 'using Pkg; \
Pkg.activate(ENV["JULIA_PROJECT"]); \
names = filter(!isempty, readlines("/home/jovyan/.julia_env_precompile_blocks/notebook.txt")); \
pkgs = [Pkg.PackageSpec(name=name) for name in names if haskey(Pkg.project().dependencies, name)]; \
Pkg.precompile(pkgs; strict=false)'
RUN julia -e 'using Pkg; \
Pkg.activate(ENV["JULIA_PROJECT"]); \
names = filter(!isempty, readlines("/home/jovyan/.julia_env_precompile_blocks/plots.txt")); \
pkgs = [Pkg.PackageSpec(name=name) for name in names if haskey(Pkg.project().dependencies, name)]; \
Pkg.precompile(pkgs; strict=false)'
RUN julia -e 'using Pkg; \
Pkg.activate(ENV["JULIA_PROJECT"]); \
names = filter(!isempty, readlines("/home/jovyan/.julia_env_precompile_blocks/makie.txt")); \
pkgs = [Pkg.PackageSpec(name=name) for name in names if haskey(Pkg.project().dependencies, name)]; \
Pkg.precompile(pkgs; strict=false)'
RUN julia -e 'using Pkg; \
Pkg.activate(ENV["JULIA_PROJECT"]); \
using LATeachingSuite, LinearAlgebra, BlockArrays, RowEchelon, LaTeXStrings, Latexify, Random; \
using PythonCall, IJulia, WebIO, DataFrames, Symbolics, AbstractAlgebra; \
using LAlatex; \
pyimport("LAFigureSpecs"); \
pyimport("matrixlayout"); \
A, X, B = gen_gj_pb(3, 3, 3); \
A = Rational{Int}.(A); \
B = Rational{Int}.(B); \
pb = ShowGE{Rational{Int}}(A, B); \
ref!(pb; gj=true); \
rref_matrix(4, 6, 3); \
gen_qr_problem(3; family=:pythagorean, maxint=2); \
gen_qr_problem(5; family=:cayley, maxint=2); \
latexify(A); \
rand(3, 3); \
df = DataFrame(a=1:3, b=4:6); \
latexify(df); \
@variables x; \
expand((x + 1)^2); \
println("Julia warmup complete")'
RUN julia -e 'using Pkg; \
Pkg.activate(ENV["JULIA_PROJECT"]); \
using LATeachingSuite, Symbolics; \
using LinearAlgebra, RowEchelon, LaTeXStrings, BlockArrays, Latexify, PythonCall; \
@variables α[1:6], x[1:6]; \
A = [1 -2 -1 1; -1 2 3 -1; 1 0 1 -3; -1 0 1 -1]; \
svg_qr, qr_spec = qr_bundle(A); \
isempty(svg_qr.svg) && error("qr_bundle returned empty SVG"); \
qr_spec === nothing && error("qr_bundle returned no spec"); \
println("QR bundle regression check OK")'
RUN julia -e 'using Pkg; \
Pkg.activate(ENV["JULIA_PROJECT"]); \
using LinearAlgebra; \
using Plots, Images, ImageShow, TestImages; \
gr(); \
img = rand(Gray{Float64}, 8, 8); \
p = plot(rand(5)); \
display(p); \
println(size(img)); \
println(typeof(p)); \
println("Plots/Images warmup complete")'
RUN julia -e 'using Pkg; \
Pkg.activate(ENV["JULIA_PROJECT"]); \
using PlotlyJS, PlotlyBase, DataFrames, JSON3, IJulia; \
df = DataFrame(x=1:3, y=4:6); \
p_df = PlotlyJS.plot(df, x=:x, y=:y, mode="lines+markers", type="scatter"); \
trace = PlotlyBase.scatter(x=1:3, y=3:5); \
p_base = PlotlyBase.Plot([trace]); \
trace3d = PlotlyBase.scatter3d(x=1:3, y=3:5, z=2:4, mode="markers"); \
p_3d = PlotlyBase.Plot([trace3d]); \
io = IOBuffer(); \
show(io, MIME("image/svg+xml"), p_3d); \
JSON3.write(p_df); \
JSON3.write(p_base); \
println("Plotly warmup complete")'
RUN mkdir -p /opt/ea42gh/docs/GenLAProblems \
 && if [ -d /opt/ea42gh/GenLAProblems/docs/src ]; then \
      cp -r /opt/ea42gh/GenLAProblems/docs/src/. /opt/ea42gh/docs/GenLAProblems/; \
    else \
      cp -r /opt/ea42gh/GenLAProblems/docs/. /opt/ea42gh/docs/GenLAProblems/; \
    fi
RUN mkdir -p /opt/ea42gh/docs/GenLAProblems/notebooks \
 && if [ -d /opt/ea42gh/GenLAProblems/docs/notebooks ]; then \
      cp -r /opt/ea42gh/GenLAProblems/docs/notebooks/. /opt/ea42gh/docs/GenLAProblems/notebooks/; \
    elif [ -d /opt/ea42gh/GenLAProblems/docs/src/notebooks ]; then \
      cp -r /opt/ea42gh/GenLAProblems/docs/src/notebooks/. /opt/ea42gh/docs/GenLAProblems/notebooks/; \
    fi

RUN mkdir -p /opt/ea42gh/docs/LAlatex/notebooks \
 && cp -r /opt/ea42gh/LAlatex/docs/src/notebooks/. /opt/ea42gh/docs/LAlatex/notebooks/
RUN find /opt/ea42gh/docs -name "*.ipynb" -print0 | xargs -0 jupyter trust

USER root
RUN chown -R jovyan:jovyan /home/jovyan/.julia
RUN rm -rf /tmp/*
USER jovyan
RUN ipython -c "ip = get_ipython(); assert 'julia' in ip.magics_manager.magics['cell']; ip.run_cell_magic('julia', '', '1 + 1')"


USER root
RUN mkdir -p /home/jovyan/.local/bin
COPY binder/inkscape /home/jovyan/.local/bin/inkscape
RUN chown jovyan:jovyan /home/jovyan/.local/bin/inkscape \
 && chmod 0755 /home/jovyan/.local/bin/inkscape

RUN rm -rf /tmp/* /var/tmp/*

USER jovyan
WORKDIR /home/jovyan

RUN git clone https://gitlab.com/ea42gh/elementary-linear-algebra.git
RUN chmod 0755 /home/jovyan/elementary-linear-algebra/bin/*
RUN ln -s /tmp /home/jovyan/tmp \
 && mkdir /home/jovyan/work

EXPOSE 8888 1234

#CMD ["jupyter", "lab", "--ip=0.0.0.0", "--no-browser", "--ServerApp.token=", "--ServerApp.password=", "--notebook-dir=/home/jovyan", "linear-algebra-notebooks/notebooks/Index.ipynb"]
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--no-browser", "--ServerApp.token=", "--ServerApp.password=", "--notebook-dir=/home/jovyan"]
