ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# --------------------------------------------------
# APT: FULL SYSTEM SUPERSET (from original image)
# --------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libffi-dev \
    libncursesw5-dev \
    xz-utils \
    wget \
    locales \
    # --------------------------------------------------
    # Core tools
    # --------------------------------------------------
    ca-certificates \
    git \
    curl \
    sudo \
    vim-tiny \
    cmake \
    build-essential \
    pkg-config \
    bash \
    \
    # --------------------------------------------------
    # X11 / GTK / graphics (DEV + runtime)
    # --------------------------------------------------
    #x11-apps
    xdg-utils \
    libgtk-3-dev \
    libglib2.0-dev \
    libgdk-pixbuf-xlib-2.0-dev \
    libpango1.0-dev \
    libx11-6 \
    libx11-dev \
    libxext-dev \
    libxrender1 \
    libxt6 \
    libgl1 \
    libcairo2-dev \
    \
    # --------------------------------------------------
    # Media / SVG / video
    # --------------------------------------------------
    pdf2svg \
    dvisvgm \
    dvipng \
    inkscape \
    ffmpeg \
    xclip \
    \
    # --------------------------------------------------
    # Graphviz
    # --------------------------------------------------
    graphviz \
    graphviz-dev \
    \
    # --------------------------------------------------
    # Fonts (FULL SUPERSET)
    # --------------------------------------------------
    fonts-dejavu \
    fonts-hack \
    fonts-lmodern \
    #fonts-liberation
    #fonts-freefont-ttf
    #fonts-noto
    #fonts-noto-cjk
    #fonts-noto-color-emoji
    fontconfig \
    \
    # --------------------------------------------------
    # LaTeX / TeX Live (FULL CTAN SUPERSET)
    # --------------------------------------------------
    latexmk \
    texlive-plain-generic \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-publishers \
    texlive-science \
    texlive-pictures \
    texlive-pstricks \
    texlive-xetex \
 && sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen \
 && locale-gen \
 && rm -rf /var/lib/apt/lists/*

# Locale env *after* generating it
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# =================================================
# remove X11 initialization path, cotrol threading
# =================================================
ENV GKSwstype=100
ENV JULIA_NUM_THREADS=4
ENV OPENBLAS_NUM_THREADS=1
ENV OMP_NUM_THREADS=1

# =================================================
# Compile the correct Python version
# =================================================

ARG PYTHON_VERSION=3.11.14

RUN wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz \
 && tar -xzf Python-${PYTHON_VERSION}.tgz \
 && cd Python-${PYTHON_VERSION} \
 && ./configure --enable-optimizations --enable-shared --prefix=/usr/local --with-ensurepip=install \
 && make -j$(nproc) \
 && make altinstall

RUN ln -sf /usr/local/bin/python3.11 /usr/local/bin/python3
RUN ldconfig

RUN python3 -m ensurepip --upgrade
RUN python3 --version && python3 -m pip --version

RUN python3 - <<'EOF'
import sysconfig
lib = sysconfig.get_config_var("LDLIBRARY")
assert lib and lib.endswith(".so"), lib
print("OK: Python shared library =", lib)
EOF

# ------------------------------------------------------
# USER add
# -----------------------------------------------------
RUN useradd -m -s /bin/bash jovyan && \
    echo "jovyan ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

ENV JULIA_DEPOT_PATH=/home/jovyan/.julia
ENV JULIA_PKG_PRECOMPILE_AUTO=0
ENV JULIA_BINDIR=/usr/local/julia/bin
ENV JULIA_PROJECT=/home/jovyan/.julia_env

# PythonCall (critical)
ENV JULIA_CONDAPKG_BACKEND=Null
ENV JULIA_PYTHONCALL_EXE=/usr/local/bin/python3

RUN mkdir -p /home/jovyan/.julia && \
    chown -R jovyan:jovyan /home/jovyan/.julia

RUN mkdir -p /etc/julia
RUN printf '%s\n' \
    'ENV["LANG"]="en_US.UTF-8"' \
    'ENV["LC_ALL"]="en_US.UTF-8"' \
    > /etc/julia/startup.jl

ENV HOME=/home/jovyan
WORKDIR /home/jovyan

USER jovyan
RUN echo "\
export PS1='-> ' \n\
export PS2='->>  ' \n\
" >> /home/jovyan/.bashrc

#RUN julia --startup-file=no -e 'using Pkg; Pkg.activate(); Pkg.precompile()'
#RUN julia -e 'using Pkg; Pkg.activate(ENV["JULIA_PROJECT"]); Pkg.instantiate()'

# ---------------------------------------------------------------
# Final user and working dir
USER jovyan
WORKDIR /home/jovyan
