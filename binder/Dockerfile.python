ARG BASE_IMAGE=julia-tex:julia1.10.12
FROM ${BASE_IMAGE}

ARG PYTHON_VERSION=3.13.15

USER root
WORKDIR /tmp

# ==========================================================================================
ENV PATH=/home/jovyan/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/local/julia/bin:/usr/sbin:/usr/bin:/sbin:/bin


# Build dependencies (minimal, but sufficient for a healthy CPython build).
# Inkscape may pull Debian's Python package as an apt dependency. The
# interpreter built below is the only Python runtime exposed by this image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates \
    build-essential \
    libssl-dev zlib1g-dev libbz2-dev libreadline-dev \
    libsqlite3-dev libffi-dev liblzma-dev tk-dev uuid-dev \
  && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    wget -O Python.tgz "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz"; \
    tar -xzf Python.tgz; \
    cd "Python-${PYTHON_VERSION}"; \
    ./configure \
      --prefix=/usr/local \
      --enable-optimizations \
      --enable-shared; \
    make -j"$(nproc)"; \
    make altinstall; \
    ln -sf "/usr/local/bin/python${PYTHON_VERSION%.*}" /usr/local/bin/python3; \
    ln -sf "/usr/local/bin/python${PYTHON_VERSION%.*}" /usr/local/bin/python; \
    ln -sfn "/usr/local/bin/python${PYTHON_VERSION%.*}" /usr/bin/python3; \
    ln -sfn "/usr/local/bin/python${PYTHON_VERSION%.*}" /usr/bin/python; \
    echo "/usr/local/lib" > /etc/ld.so.conf.d/usr-local-python.conf; \
    ldconfig; \
    python --version | grep -F "Python ${PYTHON_VERSION}"; \
    python3 --version | grep -F "Python ${PYTHON_VERSION}"; \
    test "$(command -v python)" = "/usr/local/bin/python"; \
    test "$(command -v python3)" = "/usr/local/bin/python3"; \
    test "$(readlink -f /usr/bin/python)" = "/usr/local/bin/python${PYTHON_VERSION%.*}"; \
    test "$(readlink -f /usr/bin/python3)" = "/usr/local/bin/python${PYTHON_VERSION%.*}"; \
    test "$(python -c 'import os, sys; print(os.path.realpath(sys.executable))')" = "/usr/local/bin/python${PYTHON_VERSION%.*}"; \
    test "$(python3 -c 'import os, sys; print(os.path.realpath(sys.executable))')" = "/usr/local/bin/python${PYTHON_VERSION%.*}"

# Julia interop: pin PythonCall to this interpreter; prevent CondaPkg from adding another
ENV JULIA_PYTHONCALL_EXE=/usr/local/bin/python3
ENV JULIA_CONDAPKG_BACKEND=Null
ENV JULIA_PROJECT=/home/jovyan/.julia_env
ENV JULIACALL_PROJECT=/home/jovyan/.julia_env
ENV PYTHON_JULIACALL_EXE=/usr/local/julia/bin/julia
ENV PYTHON_JULIACALL_PROJECT=/home/jovyan/.julia_env
ENV PYJULIAPKG_PROJECT=/home/jovyan/.julia_env
ENV JULIAPKG_PROJECT=/home/jovyan/.julia_env

# #########################################################################################
# enable sudo (note: could do docker exec -u root -it <container-name> bash )

RUN apt-get update && apt-get install -y sudo \
 && echo "jovyan ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/jovyan \
 && chmod 0440 /etc/sudoers.d/jovyan

# #########################################################################################
USER jovyan
WORKDIR /home/jovyan
