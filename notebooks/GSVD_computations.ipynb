    "l_show(\"A = \", A, L(r\",\\quad B = \"), B)\n",
    "l_show(L(r\"C \\approx \"), np.round(qr_csd_factors[\"C\"],3),\n",
    "       L(r\",\\quad S \\approx \"), np.round(qr_csd_factors[\"S\"],3))\n",
    "l_show(L(r\"X^{-1} \\approx \"), np.round(qr_csd_factors[\"Xinv\"],3))\n",
    "\n",
    "gamma = np.diag(qr_csd_factors[\"C\"]) / np.diag(qr_csd_factors[\"S\"])\n",
