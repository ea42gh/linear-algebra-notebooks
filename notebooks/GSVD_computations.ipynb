   "source": [
    "def gsvd_qr_csd(A, B, *, tol=None):\n",
    "    # Compose the seven demonstrated QR/CS steps into a reference GSVD.\n",
    "    A = np.asarray(A, dtype=float)\n",
    "    B = np.asarray(B, dtype=float)\n",
    "    n = A.shape[1]\n",
    "    if A.shape[0] < n or B.shape[0] < n:\n",
    "        raise ValueError(\"this thin reference implementation requires m_A >= n and m_B >= n\")\n",
    "\n",
    "    K = stack_gsvd_pair(A, B)\n",
    "    Q_A, Q_B, R = factor_stacked_pair(K, A.shape[0])\n",
    "    U, c, W     = diagonalize_upper_cs_block(Q_A)\n",
    "    s           = infer_lower_cs_magnitudes(c)\n",
    "    V           = recover_lower_cs_vectors(Q_B, W, s, tol=tol)\n",
    "    return assemble_qr_cs_factors(U, c, V, s, W, R)\n",
    "\n",
    "\n",
    "def gsvd_errors(A, B, factors):\n",
    "    U, V = factors[\"U\"], factors[\"V\"]\n",
    "    C, S, Xinv = factors[\"C\"], factors[\"S\"], factors[\"Xinv\"]\n",
    "    n = Xinv.shape[0]\n",
    "    return {\n",
    "        \"A reconstruction\": _relative_residual(A - U @ C @ Xinv, A),\n",
    "        \"B reconstruction\": _relative_residual(B - V @ S @ Xinv, B),\n",
    "        \"U orthogonality\": np.linalg.norm(U.T @ U - np.eye(n)),\n",
    "        \"V orthogonality\": np.linalg.norm(V.T @ V - np.eye(n)),\n",
    "        \"CS normalization\": np.linalg.norm(C.T @ C + S.T @ S - np.eye(n)),\n",
    "    }"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "75146f39",
   "metadata": {},
   "source": [
    "#### **Example Implementation and Test**"
   ]
  },
